# Chỉ dùng cho local/dev qua Docker — đổi mật khẩu nếu máy có thể bị truy
# cập từ người khác. Không dùng các giá trị này khi deploy thật.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin123456

# PostgreSQL (container "db" trong docker-compose.yml dùng chung các biến này)
POSTGRES_DB=attendance
POSTGRES_USER=attendance
POSTGRES_PASSWORD=attendance-dev-123
